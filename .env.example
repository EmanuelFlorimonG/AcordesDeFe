# GENESARET: public configuration for the browser build.
#
# Copy this file to .env.local and fill in the values of YOUR Supabase project
# (Project Settings > API). Without them the app keeps working with the
# bundled catalog and the contribution form reports that it is not available.
#
# Only these three public values may ever start with VITE_: everything with a
# VITE_ prefix ends up inside the JavaScript sent to every visitor.
#
# NEVER put the service_role key, a database password or any other secret in
# this file, in any VITE_ variable, or in the repository.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare Turnstile SITE key (public). Without it, sending songs is
# unavailable. Its SECRET key goes only into Supabase, from a terminal:
#   npx supabase secrets set TURNSTILE_SECRET_KEY=...
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
